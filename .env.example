# Copy to .env and fill in (scripts\start.ps1 does this on first run). NEVER commit .env.
POSTGRES_USER=aqt
POSTGRES_PASSWORD=change-me
# Host port for PostgreSQL (bound to 127.0.0.1 only). 5433 avoids clashing with a local install.
AQT_DB_PORT=5433
# Used only when running the CLI outside docker:
AQT_DATABASE_URL=postgresql+psycopg://aqt:change-me@127.0.0.1:5433/aqt
# Politeness toward TWSE/TPEx (seconds between requests to the same host). Do not go below 3.
AQT_HTTP_MIN_INTERVAL_SECONDS=5
# Full backfill window start (end defaults to yesterday)
AQT_BACKFILL_START=2019-01-01
# When a source serves its "FOR SECURITY REASONS" page: pause this long x attempt, retry the day
AQT_BACKFILL_BLOCK_COOLDOWN_SECONDS=900
AQT_BACKFILL_BLOCK_MAX_RETRIES=3
# Optional (PHASE 4+): Claude API for research/judgement modules
AQT_ANTHROPIC_API_KEY=
# Optional backup data source (FinMind free tier works without a token, with lower rate limits)
AQT_FINMIND_TOKEN=
