# Copy to .env and fill in. NEVER commit .env.
POSTGRES_USER=aqt
POSTGRES_PASSWORD=change-me
# Used when running outside docker:
AQT_DATABASE_URL=postgresql+psycopg://aqt:change-me@127.0.0.1:5432/aqt
# Optional (PHASE 4+): Claude API for research/judgement modules
AQT_ANTHROPIC_API_KEY=
# Optional backup data source (FinMind free tier works without a token, with lower rate limits)
AQT_FINMIND_TOKEN=
# Politeness toward TWSE/TPEx (seconds between requests to the same host)
AQT_HTTP_MIN_INTERVAL_SECONDS=3
